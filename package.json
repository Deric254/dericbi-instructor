{
  "name": "dericbi-instructor",
  "version": "1.4.4",
  "description": "DericBI Instructor — Personal Analytics Mentor and Training Platform",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n VITE,ELECTRON -c cyan,yellow \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win --x64",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "publish:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "keywords": [],
  "author": "Deric",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "electron-updater": "^6.2.1",
    "hyperformula": "^2.7.1",
    "lucide-react": "^0.400.0",
    "monaco-editor": "^0.50.0",
    "papaparse": "^5.4.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.deric.dericbi-instructor",
    "productName": "DericBI Instructor",
    "copyright": "Copyright © 2025 Deric",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content",
        "filter": [
          "**/*",
          "!datasets/**"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DericBI Instructor",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DericBI-Instructor-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Deric254",
      "repo": "dericbi-instructor",
      "releaseType": "release"
    }
  }
}
